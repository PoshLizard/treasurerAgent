# Frontend environment variables. Copy to .env.local and fill in the values.
# None of these use the NEXT_PUBLIC_ prefix, so they stay on the server.

# Where the FastAPI backend runs (no trailing slash)
BACKEND_URL=http://127.0.0.1:8000

# Must match the backend's API_SECRET
API_SECRET=

# Login for the Basic Auth check in proxy.ts
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
