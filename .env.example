# Backend environment variables. Copy to .env and fill in the values.
# backend/agent.py loads this file with python-dotenv.

# Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=

# Shared secret the frontend sends in the X-API-Key header.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET=

# Firecrawl API key from https://firecrawl.dev (web search and scraping for research_web)
FIRECRAWL_API_KEY=

# Optional: where the org is based, so the agent prefers local options (e.g. "Newark, Delaware")
ORG_LOCATION=
